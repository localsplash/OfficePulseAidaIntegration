[Unit]
Description=OfficePulse integration API, native PBX inventory/provisioning and operations UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aida
Group=aida
WorkingDirectory=/opt/aida-integration
EnvironmentFile=/etc/aida-integration/env
ExecStart=/usr/bin/node /opt/aida-integration/dist/index.js
Restart=always
RestartSec=2
# Graceful drain: SIGTERM stops new FastAGI/HTTP work; established
# caller-human bridges live in Asterisk and are unaffected.
TimeoutStopSec=15

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
# AF_NETLINK is required: libwebrtc (@livekit/rtc-node) enumerates network
# interfaces over netlink while gathering ICE candidates for the Agent room
# monitor. Without it only the first room connection in the process succeeds
# and every later call falls back at monitor-connect (issue #19).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
MemoryMax=512M

[Install]
WantedBy=multi-user.target
